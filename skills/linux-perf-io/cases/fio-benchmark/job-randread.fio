[global]
ioengine=libaio
direct=1
runtime=30
time_based
group_reporting
percentile_list=50:95:99:99.9

[randread-4k-qd32]
filename=/data/testfile
rw=randread
bs=4k
iodepth=32
size=1G
numjobs=1

[randwrite-4k-qd32]
stonewall
filename=/data/testfile
rw=randwrite
bs=4k
iodepth=32
size=1G
numjobs=1

[seqread-128k-qd8]
stonewall
filename=/data/testfile
rw=read
bs=128k
iodepth=8
size=1G
numjobs=1
